// Nova stdlib — stdio.nh
// Fornece std::printf como builtin do compilador (sem libc).
//
// Uso obrigatório: #include <stdio.nh>
// Prefixo obrigatório: std::printf(...)
//
// Especificadores:
//   %d  %i       int (i32, signed)
//   %u           int (i32, unsigned)
//   %ld  %li     long (i64, signed)
//   %lu          long (i64, unsigned)
//   %f  %g  %e   float ou double
//   %c           char
//   %s           string
//   %%           % literal
//
// Exemplos:
//   std::printf("Hello, World!\n");
//   std::printf("nome: %s, idade: %d\n", "Saulo", 21);
//   std::printf("long: %ld\n", 9876543210);
//   std::printf("pi: %f\n", 3.14159);
//   std::printf("char: %c\n", 'A');

namespace std;

fn printf(fmt: string, ...);
fn print(n: i32);
fn print(n: f64);
fn print(n: f32);
fn print(s: string);
fn print(c: char);
fn print(n: i64);