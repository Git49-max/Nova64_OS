// 06_globais.npp
// Testa variáveis e arrays globais acessíveis entre funções

int contador = 0;
int historico[5];
string mensagem = "ok";

void incrementar() {
    contador = contador + 1;
}

void registrar(int pos, int val) {
    historico[pos] = val;
}

int lerContador() {
    return contador;
}

void main() {
    print(contador);    // 0

    incrementar();
    incrementar();
    incrementar();
    print(lerContador()); // 3

    registrar(0, 10);
    registrar(1, 20);
    registrar(2, 30);
    print(historico[0]);  // 10
    print(historico[1]);  // 20
    print(historico[2]);  // 30

    print(mensagem);      // ok
}
