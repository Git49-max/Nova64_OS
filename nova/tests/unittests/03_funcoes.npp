// 03_funcoes.npp
// Testa declaração e chamada de funções, retorno, recursão

int soma(int a, int b) {
    return a + b;
}

float media(float a, float b) {
    return (a + b) / 2.0;
}

int fatorial(int n) {
    if (n <= 1) then {
        return 1;
    }
    return n * fatorial(n - 1);
}

int fibonacci(int n) {
    if (n <= 1) then {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

void saudacao(string nome) {
    print(nome);
}

void main() {
    print(soma(3, 4));          // 7
    print(soma(100, 200));      // 300

    print(fatorial(5));         // 120
    print(fatorial(10));        // 3628800

    print(fibonacci(0));        // 0
    print(fibonacci(1));        // 1
    print(fibonacci(7));        // 13

    saudacao("Hello Nova");     // Hello Nova
}
