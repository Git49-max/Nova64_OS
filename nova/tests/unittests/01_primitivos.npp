// 01_primitivos.npp
// Testa declaração e operações básicas com tipos primitivos

void main() {
    // Inteiros
    int a = 10;
    int b = 3;
    print(a + b);    // 13
    print(a - b);    // 7
    print(a * b);    // 30
    print(a / b);    // 3
    print(a % b);    // 1

    // Floats
    float x = 3.14;
    float y = 2.0;
    print(x + y);    // 5.14
    print(x * y);    // 6.28

    // Strings
    string s = "Nova";
    print(s);        // Nova

    // Negativo
    int neg = 0 - 5;
    print(neg);      // -5
}
