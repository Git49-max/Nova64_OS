// 05_structs.npp
// Testa definição de struct, campos e métodos

struct Ponto {
    int x;
    int y;

    void mover(int dx, int dy) {
        x = x + dx;
        y = y + dy;
    }

    int distanciaOrigem() {
        return x * x + y * y;
    }
}

struct Retangulo {
    int largura;
    int altura;

    int area() {
        return largura * altura;
    }

    int perimetro() {
        return (largura + altura) * 2;
    }
}

void main() {
    // Campos básicos
    Ponto p;
    p.x = 3;
    p.y = 4;
    print(p.x);   // 3
    print(p.y);   // 4

    // Método que modifica campos
    p.mover(2, 1);
    print(p.x);   // 5
    print(p.y);   // 5

    // Método que retorna valor
    print(p.distanciaOrigem());  // 50  (5*5 + 5*5)

    // Segundo struct
    Retangulo r;
    r.largura = 6;
    r.altura = 4;
    print(r.area());        // 24
    print(r.perimetro());   // 20

    // Múltiplas instâncias independentes
    Ponto a;
    Ponto b;
    a.x = 1;
    b.x = 99;
    print(a.x);  // 1
    print(b.x);  // 99
}
