// 04_arrays.npp
// Testa declaração, leitura, escrita e inicialização de arrays

void main() {
    // Declaração e acesso
    int nums[5];
    nums[0] = 10;
    nums[1] = 20;
    nums[2] = 30;
    nums[3] = 40;
    nums[4] = 50;
    print(nums[0]);   // 10
    print(nums[2]);   // 30
    print(nums[4]);   // 50

    // Inicialização direta
    int primos[5] = {2, 3, 5, 7, 11};
    print(primos[0]); // 2
    print(primos[4]); // 11

    // Acesso via variável (índice dinâmico)
    int idx = 2;
    print(primos[idx]); // 5

    // Array em loop
    int soma = 0;
    for (int i = 0; i < 5; i++) {
        soma = soma + primos[i];
    }
    print(soma);    // 28  (2+3+5+7+11)

    // Array de float
    float coords[3] = {1.0, 2.5, 3.0};
    print(coords[1]); // 2.500000

    // Modificação em loop
    int dobro[4] = {1, 2, 3, 4};
    for (int i = 0; i < 4; i++) {
        dobro[i] = dobro[i] * 2;
    }
    print(dobro[0]); // 2
    print(dobro[3]); // 8
}
