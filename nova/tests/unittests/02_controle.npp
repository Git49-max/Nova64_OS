// 02_controle.npp
// Testa if/else, while, for

void main() {
    // if / else
    int x = 10;
    if (x > 5) then {
        print(1);   // 1
    } else {
        print(0);
    }

    if (x == 99) then {
        print(0);
    } else {
        print(2);   // 2
    }

    // while
    int i = 0;
    while (i < 3) {
        print(i);   // 0 1 2
        i++;
    }

    // for
    for (int j = 0; j < 4; j++) {
        print(j);   // 0 1 2 3
    }

    // for com step composto
    for (int k = 10; k > 0; k -= 3) {
        print(k);   // 10 7 4 1
    }

    // && e ||
    int a = 1;
    int b = 0;
    if (a == 1 && b == 0) then {
        print(3);   // 3
    }
    if (a == 0 || b == 0) then {
        print(4);   // 4
    }

    // ! (not)
    if (!b) then {
        print(5);   // 5
    }
}
