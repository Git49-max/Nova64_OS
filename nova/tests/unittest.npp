int total_geral = 0;
int rodadas = 3;

void main() {
    int i = 0;
    print("Iniciando Labirinto de Fluxo...");

    while (i < rodadas) {
        int j = 0;
        print("Rodada externa:");
        print(i);

        for (j = 0; j < 2; j = j + 1) {
            if (i == 1 && j == 1) then {
                print("Evento especial: i=1, j=1");
                total_geral = total_geral + 100;
            } else if (i == 2) then {
                total_geral = total_geral + 10;
            } else {
                total_geral = total_geral + 1;
            }
            
            print("Status parcial do total:");
            print(total_geral);
        }
        
        i = i + 1;
    }

    print("--- RESULTADO FINAL ---");
    if (total_geral == 123) then {
        print("LOGICA PERFEITA: O total deu 123");
    } else {
        print("ERRO NA LOGICA: O valor calculado foi:");
        print(total_geral);
    }
}